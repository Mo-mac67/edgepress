{
  "name": "edgepress-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "edgepress-monorepo",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@edgepress/ai": {
      "resolved": "packages/ai",
      "link": true
    },
    "node_modules/@edgepress/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/create-edgepress": {
      "resolved": "packages/create-edgepress",
      "link": true
    },
    "packages/ai": {
      "name": "@edgepress/ai",
      "version": "0.1.0",
      "license": "MIT",
      "peerDependencies": {
        "@edgepress/core": "*"
      }
    },
    "packages/core": {
      "name": "@edgepress/core",
      "version": "0.1.0",
      "license": "MIT",
      "peerDependencies": {
        "@opennextjs/cloudflare": ">=1.0.0",
        "pg": ">=8"
      },
      "peerDependenciesMeta": {
        "@opennextjs/cloudflare": {
          "optional": true
        },
        "pg": {
          "optional": true
        }
      }
    },
    "packages/create-edgepress": {
      "version": "0.2.0",
      "license": "MIT",
      "bin": {
        "create-edgepress": "bin/index.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
